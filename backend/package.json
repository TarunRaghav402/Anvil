{
  "name": "anvil-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API, Socket.io session manager, Yjs CRDT server, and sandboxed Git push service for Anvil",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/anvil.git",
    "directory": "backend"
  },
  "keywords": [
    "anvil",
    "express",
    "socketio",
    "yjs",
    "firebase-admin",
    "dataconnect"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/backend/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "seed": "tsx src/scripts/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx scripts/e2eEmulators.ts"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.0.0",
    "lib0": "^0.2.102",
    "mime-types": "^2.1.35",
    "multer": "^2.0.1",
    "socket.io": "^4.8.1",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.33",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
