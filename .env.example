# ==============================================================================
# Anvil Environment Configuration
# Copy this file to `.env` at the repository root before starting Anvil.
# NEVER commit your real `.env` file or service account credentials.
# ==============================================================================

# --- Runtime Environment ---
# "development", "test", or "production"
NODE_ENV=development
# TCP port for the Express + Socket.io + Yjs backend server
PORT=4001
# Allowed frontend origin for CORS and sandboxed Live Preview CSP frame-ancestors
FRONTEND_ORIGIN=http://localhost:5173

# --- Firebase Project & Local Emulators ---
# Firebase project ID (Firebase Console -> Project Settings -> General).
# For local-only emulator testing without a cloud project, "demo-anvil" works offline.
FIREBASE_PROJECT_ID=demo-anvil
# Default Cloud Storage bucket name (<project-id>.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=demo-anvil.firebasestorage.app
# Set to "true" for local Firebase Emulator Suite; "false" for production Firebase
USE_FIREBASE_EMULATORS=true

# Emulator host:port bindings (required when USE_FIREBASE_EMULATORS=true)
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
DATA_CONNECT_EMULATOR_HOST=127.0.0.1:9399

# Firebase Data Connect (SQL Connect) configuration (matches dataconnect/dataconnect.yaml)
DATA_CONNECT_SERVICE_ID=anvil-dataconnect
DATA_CONNECT_LOCATION=us-central1
DATA_CONNECT_CONNECTOR=anvil-connector

# --- Production Server Credentials (leave empty when USE_FIREBASE_EMULATORS=true) ---
# Path to a downloaded Firebase Admin SDK service account JSON file (outside repo or gitignored)
GOOGLE_APPLICATION_CREDENTIALS=
# Or inline single-line JSON string of the Firebase service account (useful on PaaS hosts)
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Session & Tier Feature Flags ---
# Grace period (ms) before host disconnection ends a non-persistent live session
SESSION_HOST_GRACE_MS=30000
# Scaffolded paid tier flag ("false" = free mode only; persistent sessions disabled)
ENABLE_PAID_TIERS=false

# --- Real-time Sync, Preview & Git Security ---
# Debounce delay (ms) before flushing Yjs CRDT edits to PostgreSQL via Data Connect
YJS_SAVE_DEBOUNCE_MS=2000
# HMAC secret (>= 16 chars) for short-lived Live Preview capability tokens.
# MUST be replaced with a strong random string in production.
PREVIEW_TOKEN_SECRET=replace-with-random-32-char-secret-change-in-production
# Maximum binary upload size per file (MB)
MAX_UPLOAD_SIZE_MB=15
# Timeout (ms) for server-side Git Commit & Push operations
GIT_TIMEOUT_MS=60000

# --- Frontend Client Variables (Vite requires the VITE_ prefix) ---
# Backend REST base URL (leave empty or point to backend port in local dev)
VITE_API_URL=http://localhost:4001
# Backend WebSocket base URL for Yjs collaboration
VITE_WS_URL=ws://localhost:4001
# Set to "true" to connect the browser client to Firebase Auth/Storage Emulators
VITE_USE_EMULATORS=true

# Firebase Web App configuration (Firebase Console -> Project Settings -> Your apps -> Web app).
# Note: Firebase web config values identify your project (protected by Auth & rules), not secret keys.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-anvil.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-anvil
VITE_FIREBASE_STORAGE_BUCKET=demo-anvil.firebasestorage.app
VITE_FIREBASE_APP_ID=your-firebase-web-app-id

# Browser emulator endpoints (required when VITE_USE_EMULATORS=true)
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_STORAGE_EMULATOR_PORT=9199
VITE_FIREBASE_DATACONNECT_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_DATACONNECT_EMULATOR_PORT=9399
